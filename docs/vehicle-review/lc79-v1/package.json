    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-node": "3.2.4",
    "prettier": "3.9.10",
    "three-mesh-bvh": "0.9.16"
  }
}
